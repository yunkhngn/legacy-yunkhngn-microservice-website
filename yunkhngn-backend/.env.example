# Database Connection
# Use mssql as hostname if running in Docker, or localhost for local dev
DATABASE_URL="sqlserver://localhost:1433;database=blogdb;user=sa;password=YourStrongPassword;encrypt=false"

# Server Configuration
PORT=3001
REDIS_HOST=localhost
CORS_ORIGIN=http://localhost:3000

# Firebase Admin SDK
# Path to your service account JSON file
FIREBASE_CREDENTIALS="./firebase-admin-sdk.json"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI (Google Gemini) — optional. Prefer Admin → Settings → gemini_api_key (stored in DB).
# Set this only if you want a fallback (e.g. local dev before seeding settings, or CI).
# GEMINI_API_KEY=

# External Service URLs (optional for boot — có default/fallback trong code)
# Nên set trên production để link email, newsletter, CORS đúng domain.
FRONTEND_URL=http://localhost:3000
# Python letter-handwriting service; nếu không dùng tính năng letter AI có thể bỏ (fallback localhost:8000)
LETTER_AI_URL=http://localhost:8000

# WakaTime (optional — prefer Admin → Settings → wakatime_api_key)
# WAKATIME_API_KEY=

# Steam (optional — prefer Admin → Settings → steam_api_key / steam_user_id)
# STEAM_API_KEY=
# STEAM_USER_ID=

# OpenWeatherMap (optional — prefer Admin → Settings → openweather_api_key)
# OPENWEATHER_API_KEY=

# Locket backup (optional — prefer Admin → Settings → locket_firebase_api_key)
# LOCKET_FIREBASE_API_KEY=
