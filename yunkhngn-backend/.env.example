# Database Connection
# Use mssql as hostname if running in Docker, or localhost for local dev
DATABASE_URL="sqlserver://localhost:1433;database=blogdb;user=sa;password=YourStrongPassword;encrypt=false"

# Server Configuration
PORT=3001
REDIS_HOST=localhost
CORS_ORIGIN=http://localhost:3000

# Firebase Admin SDK
# Path to your service account JSON file
FIREBASE_CREDENTIALS="./firebase-admin-sdk.json"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI (Google Gemini) — optional. Prefer Admin → Settings → gemini_api_key (stored in DB).
# Set this only if you want a fallback (e.g. local dev before seeding settings, or CI).
# GEMINI_API_KEY=

# External Service URLs
FRONTEND_URL=http://localhost:3000
LETTER_AI_URL=http://localhost:8000
